# Spring Boot 기본 설정
spring.application.name=ige
server.port=8081

# H2 데이터베이스 설정 (개발용)
spring.datasource.url=jdbc:h2:mem:ige
spring.datasource.driverClassName=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=

# H2 콘솔 활성화
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# JPA 설정
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.jpa.hibernate.ddl-auto=create-drop
spring.jpa.show-sql=true

# 데이터 초기화 설정
spring.sql.init.mode=always
spring.jpa.defer-datasource-initialization=true

# MySQL 설정 (운영 환경용 - 주석 해제하여 사용)
#spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
#spring.datasource.url=jdbc:mysql://localhost:3306/ige
#spring.datasource.username=your_username
#spring.datasource.password=your_password

# Naver API 설정 (환경변수로 관리 권장)
naver.client-id=${NAVER_CLIENT_ID:your_naver_client_id}
naver.secret=${NAVER_SECRET:your_naver_secret}

# Kakao Map 설정 (환경변수로 관리 권장)
kakao.map.client-id=${KAKAO_MAP_CLIENT_ID:your_kakao_map_client_id}

